# ===== Supabase =====
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ===== Upstash Redis =====
